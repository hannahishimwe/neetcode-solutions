class Solution:
    def maxArea(self, heights: List[int]) -> int:
        l, r=0, len(heights)-1
        maxArea = 0
        while l<r:
            height = min(heights[l], heights[r])
            width = r-l
            area = height*width
            if area > maxArea:
                maxArea = area
            if heights[l]<heights[r]:
                l+=1
            else:
                r-=1
            if l==r:
                return maxArea
            else:
                continue
        return maxArea


        
